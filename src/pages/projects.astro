---
export const prerender = true;
import Layout from "../layouts/Layout.astro";

interface Project {
  name: string;
  tag: string;
  date: string;
  html: string;
}

const ownProjects: Project[] = [
  {
    name: "Seismo",
    tag: "Chrome Extension",
    date: "2025",
    html: 'Monitors every browser request and surfaces errors instantly with colour-coded alerts. Privacy-first design, dev-friendly debugging tools and smart root-cause analysis. <a href="https://chromewebstore.google.com/detail/seismo/ojdbiddhfbcchdabkhampaefmmkochgj" target="_blank" rel="noopener noreferrer">Chrome Store</a>.',
  },
  {
    name: "TheAgenticBrowser",
    tag: "Multi-agent · AI",
    date: "2024",
    html: 'Open-source browser agent that turns natural language into completed tasks. Can do research, e-commerce, form filling, cross-domain scraping and much more. Unlike scripted automation, it self-corrects itself via a 3 agent systemic loop. Planner -> Executor -> Critique until the task is done. <a href="https://github.com/TheAgenticAI/TheAgenticBrowser" target="_blank" rel="noopener noreferrer">GitHub</a>.',
  },
  {
    name: "CortexON",
    tag: "Multi-agent · AI",
    date: "2024",
    html: 'Generalised open-source AI agent that coordinates five specialists : Web, File, Coder, Executor, API. Enabling them to handle research, code generation, file management and API integrations. Ships with a full React UI and HITL controls. <a href="https://github.com/TheAgenticAI/CortexON" target="_blank" rel="noopener noreferrer">GitHub</a>.',
  },
];

const clientProjects: Project[] = [
  {
    name: "Bitcoin Trading System",
    tag: "Agentic · Trading",
    date: "2025",
    html: "Multi-agent technical analysis using Agentic AI. Each agent owns a specific technical lens (Elliott Wave, Volume/OI, Lunar cycles, Market Events, etc) and all of them coordinate together to trade Bitcoin.",
  },
  {
    name: "Personal Finance AI",
    tag: "AI · FinTech",
    date: "2025",
    html: "Fine-tuned on a proprietary dataset with custom training pipelines. Ingests credit reports, cards, and real spending data to give personalised advice. Built to handle the messy, contradictory data that generic models can't.",
  },
  {
    name: "Real Estate Video Generator",
    tag: "AI · Generative",
    date: "2025",
    html: "Property address or images in, finished listing video out. A multi-stage pipeline with image analysis, feature extraction, storyboarding, voiceover, music selection and transitions.",
  },
  {
    name: "Options Trader",
    tag: "Agentic · Trading",
    date: "2025",
    html: "Autonomous options trader combining proprietary strategies with ML models. Millisecond execution with 30+ metrics collected per trade cycle, feeding back in to improve continuously.",
  },
];
---

<Layout
  title="Projects — Abhigyan Bafna"
  description="Selected projects by Abhigyan Bafna."
  crumb="projects"
>
  <div class="proj-list">
    {
      ownProjects.map((p) => (
        <div class="proj-item">
          <div class="proj-header">
            <div class="proj-left">
              <span class="proj-name">{p.name}</span>
              <span class="proj-name-sep">·</span>
              <span class="proj-tag">{p.tag}</span>
            </div>
            <span class="proj-date">{p.date}</span>
          </div>
          <p class="proj-desc" set:html={p.html} />
        </div>
      ))
    }

    <div class="proj-section-rule">
      <span class="proj-section-label">client work</span>
    </div>

    {
      clientProjects.map((p) => (
        <div class="proj-item">
          <div class="proj-header">
            <div class="proj-left">
              <span class="proj-name">{p.name}</span>
              <span class="proj-name-sep">·</span>
              <span class="proj-tag">{p.tag}</span>
            </div>
            <span class="proj-date">{p.date}</span>
          </div>
          <p class="proj-desc" set:html={p.html} />
        </div>
      ))
    }
  </div>
</Layout>
