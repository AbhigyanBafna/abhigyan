---
interface Props {
  title: string;
  slug: string;
}

const { title, slug } = Astro.props;
---

<div class="share-wrap" data-slug={slug}>
  <button class="like-btn" id="like-btn" type="button" aria-label="Like this post">
    <svg class="like-icon" width="25" height="25" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M8 13.5C8 13.5 1.5 9.5 1.5 5.5C1.5 3.567 3.067 2 5 2C6.09 2 7.063 2.522 7.69 3.334L8 3.75L8.31 3.334C8.937 2.522 9.91 2 11 2C12.933 2 14.5 3.567 14.5 5.5C14.5 9.5 8 13.5 8 13.5Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
    </svg>
    <span class="like-count" id="like-count">—</span>
  </button>

  <button class="share-btn" id="share-btn" type="button" aria-label="Share this post">
    <svg width="25" height="25" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="12" cy="2.5" r="1.75" stroke="currentColor" stroke-width="1.25"/>
      <circle cx="12" cy="13.5" r="1.75" stroke="currentColor" stroke-width="1.25"/>
      <circle cx="3" cy="8" r="1.75" stroke="currentColor" stroke-width="1.25"/>
      <line x1="4.7" y1="7.1" x2="10.4" y2="3.3" stroke="currentColor" stroke-width="1.25"/>
      <line x1="4.7" y1="8.9" x2="10.4" y2="12.7" stroke="currentColor" stroke-width="1.25"/>
    </svg>
  </button>

  <div class="share-popover" id="share-popover" hidden>
    <button class="share-option" id="copy-link" type="button">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="1.5" y="4.5" width="9" height="10" rx="1.5" stroke="currentColor" stroke-width="1.25"/>
        <path d="M5.5 4V3.5A1.5 1.5 0 0 1 7 2h6.5A1.5 1.5 0 0 1 15 3.5v7A1.5 1.5 0 0 1 13.5 12H13" stroke="currentColor" stroke-width="1.25"/>
      </svg>
      <span id="copy-label">copy link</span>
    </button>
    <a class="share-option" id="share-x" href="#" target="_blank" rel="noopener noreferrer">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9.294 6.928 14.357 1h-1.2L8.762 6.147 5.25 1H1l5.31 7.728L1 15h1.2l4.642-5.396L10.75 15H15L9.294 6.928Zm-1.644 1.91-.538-.77-4.28-6.123h1.843l3.454 4.94.537.769 4.49 6.422h-1.843L7.65 8.837Z"/>
      </svg>
      post on x
    </a>
    <a class="share-option" id="share-linkedin" href="#" target="_blank" rel="noopener noreferrer">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/>
      </svg>
      share on linkedin
    </a>
  </div>
</div>

<script>
  const wrap = document.querySelector<HTMLElement>(".share-wrap")!;
  const slug = wrap.dataset.slug!;
  const likeBtn = document.getElementById("like-btn")!;
  const likeCount = document.getElementById("like-count")!;

  // ── View ping (fire-and-forget) ──
  fetch("/api/view", {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify({ slug }),
  }).catch(() => {});

  // ── Like button ──
  const likedKey = `liked:${slug}`;
  let liked = localStorage.getItem(likedKey) === "1";
  likeBtn.classList.toggle("liked", liked);

  async function fetchLikes() {
    try {
      const res = await fetch(`/api/like?slug=${encodeURIComponent(slug)}`);
      const { likes } = await res.json();
      if (liked && likes === 0) {
        // localStorage says liked but Redis is 0 — previous POST failed, heal it
        const healRes = await fetch("/api/like", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ slug }),
        });
        const { likes: healed } = await healRes.json();
        likeCount.textContent = String(healed);
      } else {
        likeCount.textContent = String(likes);
      }
    } catch {
      likeCount.textContent = "—";
    }
  }
  fetchLikes();

  likeBtn.addEventListener("click", async () => {
    const action = liked ? "unlike" : "like";
    liked = !liked;
    likeBtn.classList.toggle("liked", liked);
    if (liked) {
      localStorage.setItem(likedKey, "1");
    } else {
      localStorage.removeItem(likedKey);
    }
    try {
      const res = await fetch("/api/like", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ slug, action }),
      });
      const { likes } = await res.json();
      likeCount.textContent = String(likes);
    } catch {
      // revert optimistic update on failure
      liked = !liked;
      likeBtn.classList.toggle("liked", liked);
      if (liked) localStorage.setItem(likedKey, "1");
      else localStorage.removeItem(likedKey);
    }
  });

  // ── Share button ──
  const btn = document.getElementById("share-btn")!;
  const popover = document.getElementById("share-popover")!;
  const copyBtn = document.getElementById("copy-link")!;
  const copyLabel = document.getElementById("copy-label")!;
  const xLink = document.getElementById("share-x") as HTMLAnchorElement;
  const linkedinLink = document.getElementById("share-linkedin") as HTMLAnchorElement;

  const pageTitle = document.title.replace(/ — Abhigyan Bafna$/, "");
  const pageUrl = window.location.href;

  xLink.href = `https://x.com/intent/tweet?text=${encodeURIComponent(pageTitle)}&url=${encodeURIComponent(pageUrl)}`;
  linkedinLink.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;

  btn.addEventListener("click", async () => {
    if (navigator.share) {
      try {
        await navigator.share({ title: pageTitle, url: pageUrl });
        return;
      } catch {
        // cancelled or failed — fall through to popover
      }
    }
    popover.hidden = !popover.hidden;
  });

  copyBtn.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(pageUrl);
      copyLabel.textContent = "copied!";
      setTimeout(() => { copyLabel.textContent = "copy link"; }, 2000);
    } catch {
      copyLabel.textContent = "copy failed";
      setTimeout(() => { copyLabel.textContent = "copy link"; }, 2000);
    }
  });

  document.addEventListener("click", (e) => {
    if (!popover.hidden && !popover.contains(e.target as Node) && e.target !== btn) {
      popover.hidden = true;
    }
  });
</script>
