---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  variant?: "inset" | "wide";
}

const { src, alt, caption, variant = "inset" } = Astro.props;
---

<figure class={`post-figure post-figure--${variant}`}>
  <Image src={src} alt={alt} />
  {caption && <figcaption class="post-caption">{caption}</figcaption>}
</figure>
